# Prefer Google Tag Manager for production measurement. Example: GTM-XXXXXXX
VITE_GTM_ID=

# Optional direct GA4 fallback when GTM is not used. Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Search Console verification is normally completed through DNS or an HTML meta tag.
# Add the exact Google-provided token only when available; do not invent one.
VITE_GOOGLE_SITE_VERIFICATION=

# Property inventory database: server-only PostgreSQL/Neon connection string.
# Never prefix this with VITE_. The property-listing API creates its table/indexes on first successful submission.
ANANTHA_DATABASE_URL=

# Property verification admin Google SSO. Server-only and independent from GBP.
# You may reuse the same Google OAuth client used by GBP, but the property admin does not require GBP APIs, Redis, or GBP encryption.
PROPERTY_GOOGLE_CLIENT_ID=
PROPERTY_GOOGLE_CLIENT_SECRET=
PROPERTY_ADMIN_ORIGIN=https://www.anantharealestate.in
# Comma-separated exact Google account emails allowed into /admin/properties.
PROPERTY_ADMIN_EMAILS=shashankjanapati@gmail.com
# Optional dedicated cookie-signing secret. If blank, PROPERTY_GOOGLE_CLIENT_SECRET (or GBP_GOOGLE_CLIENT_SECRET fallback) signs the session.
PROPERTY_ADMIN_SESSION_SECRET=
# Google OAuth authorized redirect URI required for this SSO:
# https://www.anantharealestate.in/api/property-auth?action=callback

# GBP admin: server-only. Never prefix any of these with VITE_.
GBP_GOOGLE_CLIENT_ID=
GBP_GOOGLE_CLIENT_SECRET=
GBP_APP_ORIGIN=https://www.anantharealestate.in
# Comma-separated exact Google account emails; no default administrator.
GBP_ADMIN_EMAILS=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GBP_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional direct Google Ads conversion tracking when GTM is not configured.
# Example ID: AW-123456789. The label is the value after the slash in a
# Google Ads conversion destination such as AW-123456789/AbCdEfGhIjk.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=

# Optional direct Meta Pixel fallback. Prefer managing Meta through GTM when
# VITE_GTM_ID is configured.
VITE_META_PIXEL_ID=
